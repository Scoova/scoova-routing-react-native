{
  "name": "@scoova/routing-react-native",
  "version": "1.1.2",
  "description": "React Native build of @scoova/routing \u2014 Valhalla wrapper for the Scoova routing gateway (api.scoo-va.info/api/v1/routing). Pure TypeScript, no native modules.",
  "main": "lib/typescript/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src/",
    "lib/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "Apache-2.0",
  "author": "Scoova <info@scoo-va.info>",
  "homepage": "https://github.com/Scoova/scoova-routing-react-native",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Scoova/scoova-routing-react-native.git"
  },
  "bugs": {
    "url": "https://github.com/Scoova/scoova-routing-react-native/issues"
  },
  "keywords": [
    "scoova",
    "routing",
    "valhalla",
    "react-native",
    "directions",
    "isochrone",
    "matrix",
    "mapmatch",
    "polyline"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/react": "^18.2.0",
    "jest": "^29.7.0",
    "react": "18.2.0",
    "react-native": "0.74.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.4.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/test/**/*.test.ts"
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
